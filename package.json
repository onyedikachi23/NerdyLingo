{
	"name": "monorepo",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types"
	},
	"overrides": {
		"expo-modules-core": "3.0.23"
	},
	"devDependencies": {
		"turbo": "^2.5.6"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "npm@11.2.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
